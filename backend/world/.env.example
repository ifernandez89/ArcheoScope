# HRM-World Engine Configuration

# HRM Configuration
HRM_CHECKPOINT_PATH=backend/hrm/checkpoints/maze-30x30-hard/checkpoint
HRM_DEVICE=cpu
HRM_CYCLES=2

# LLM Configuration
LLM_MODEL=qwen2.5:3b
LLM_SMALL_MODEL=qwen2.5:0.5b
LLM_MEDIUM_MODEL=qwen2.5:1.5b
LLM_LARGE_MODEL=qwen2.5:3b
OLLAMA_URL=http://localhost:11434

# World Configuration
WORLD_ZONES=64
ENABLE_PROPAGATION=true
PROPAGATION_STEPS=3
ENABLE_CASCADE=true

# Performance
MAX_HISTORY=100
CACHE_SIZE=1000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
API_WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Monitoring
ENABLE_METRICS=true
METRICS_INTERVAL=60
